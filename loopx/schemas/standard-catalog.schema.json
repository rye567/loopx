{
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "rule_sets", "rules", "stage_contracts", "extensions"],
  "properties": {
    "catalog_version": {"type": "string", "minLength": 1},
    "rule_sets": {"type": "object"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "domain",
          "source",
          "stages",
          "modes",
          "risk_tags_any",
          "level",
          "check",
          "evidence_types",
          "unavailable",
          "return_to"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "enum": ["common", "architecture", "security", "performance", "reliability", "observability", "testing"]},
          "source": {"type": "string", "minLength": 1},
          "stages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "modes": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["LIGHT", "STANDARD", "FULL"]}},
          "risk_tags_any": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "level": {"type": "string", "enum": ["required", "recommended"]},
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": {"type": "string", "enum": ["schema", "builtin", "command", "review"]},
              "id": {"type": "string", "minLength": 1}
            }
          },
          "evidence_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "unavailable": {"type": "string", "enum": ["BLOCKED", "CI_REQUIRED", "SKIPPED"]},
          "return_to": {"type": "string", "minLength": 1}
        }
      }
    },
    "stage_contracts": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
