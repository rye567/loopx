{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "artifact",
    "approved",
    "gate_result"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "NOT_CREATED",
        "DRAFT",
        "APPROVED",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "NEED_HUMAN"
      ]
    },
    "artifact": {
      "type": "string"
    },
    "approved": {
      "type": "boolean"
    },
    "gate_result": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "NEED_HUMAN",
        "SKIPPED"
      ]
    },
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
