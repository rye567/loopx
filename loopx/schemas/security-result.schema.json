{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "run_id",
    "stage",
    "document",
    "requirement_ids",
    "rule_results",
    "controls",
    "residual_risks"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "enum": [
        "security_result"
      ]
    },
    "artifact_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "quality_audit",
        "test_execution"
      ]
    },
    "document": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence",
          "reason"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "CHANGES_REQUIRED",
              "BLOCKED",
              "CI_REQUIRED",
              "SKIPPED",
              "ACCEPTED_RISK"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "status",
          "verification",
          "evidence",
          "remaining_risk"
        ],
        "properties": {
          "control": {
            "type": "string",
            "enum": [
              "identity",
              "permission",
              "tenant_scope",
              "input",
              "sensitive_data",
              "dependency",
              "external_side_effect"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "CHANGES_REQUIRED",
              "BLOCKED",
              "CI_REQUIRED",
              "SKIPPED",
              "ACCEPTED_RISK"
            ]
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "remaining_risk": {
            "type": "string"
          }
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
