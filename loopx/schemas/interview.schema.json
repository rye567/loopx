{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "status",
    "artifact",
    "unanswered_questions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "PASS",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "NEED_HUMAN"
      ]
    },
    "artifact": {
      "type": "string"
    },
    "unanswered_questions": {
      "type": "integer"
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmed_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
