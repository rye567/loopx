{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "run_id",
    "stage",
    "document",
    "requirement_ids",
    "rule_results",
    "decisions",
    "impact",
    "quality_attributes",
    "performance_targets",
    "rollback",
    "verification_refs",
    "work_items"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "enum": [
        "solution"
      ]
    },
    "artifact_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "solution_design",
        "solution_review"
      ]
    },
    "document": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "status",
          "evidence",
          "reason"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "CHANGES_REQUIRED",
              "BLOCKED",
              "CI_REQUIRED",
              "SKIPPED",
              "ACCEPTED_RISK"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_ids",
          "summary",
          "rationale",
          "alternatives"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "contracts",
        "data",
        "configuration",
        "dependencies"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "configuration": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quality_attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simplicity",
        "module_boundaries",
        "security",
        "performance",
        "extensibility",
        "compatibility",
        "reliability",
        "observability"
      ],
      "properties": {
        "simplicity": {
          "type": "object"
        },
        "module_boundaries": {
          "type": "object"
        },
        "security": {
          "type": "object"
        },
        "performance": {
          "type": "object"
        },
        "extensibility": {
          "type": "object"
        },
        "compatibility": {
          "type": "object"
        },
        "reliability": {
          "type": "object"
        },
        "observability": {
          "type": "object"
        }
      }
    },
    "performance_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "unit",
          "target",
          "target_source",
          "load",
          "environment",
          "baseline",
          "allowed_variation",
          "evidence"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "target_source": {
            "type": "string",
            "minLength": 1
          },
          "load": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string",
            "minLength": 1
          },
          "allowed_variation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "steps",
        "validation",
        "reason"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "verification_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "risk_tags",
          "owner_agent",
          "read_scope",
          "write_scope",
          "dependencies",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "risk_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner_agent": {
            "type": "string",
            "minLength": 1
          },
          "read_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "write_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
