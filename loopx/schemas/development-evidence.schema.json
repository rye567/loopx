{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "run_id",
    "stage",
    "document",
    "requirement_ids",
    "rule_results",
    "changed_files",
    "write_scope",
    "dependency_changes",
    "acceptance_mapping",
    "commands",
    "residual_risks"
  ],
  "properties": {
    "artifact_type": {"type": "string", "enum": ["development_evidence"]},
    "artifact_version": {"type": "string", "enum": ["1"]},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["development"]},
    "document": {"type": "string", "minLength": 1},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "status", "evidence", "reason"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED", "CI_REQUIRED", "SKIPPED", "ACCEPTED_RISK"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string"}
        }
      }
    },
    "changed_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "write_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependency_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "reason", "approval"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["added", "updated", "removed"]},
          "reason": {"type": "string", "minLength": 1},
          "approval": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "files", "tests"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "status", "exit_code", "evidence", "ci_required"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED", "CI_REQUIRED", "SKIPPED"]},
          "exit_code": {"type": "integer"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ci_required": {"type": "boolean"}
        }
      }
    },
    "residual_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {"type": "object"}
  }
}
