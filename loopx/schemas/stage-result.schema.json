{
  "type": "object",
  "required": [
    "stage",
    "status",
    "return_to",
    "next_action",
    "affected_work_items",
    "evidence",
    "user_confirmation_required",
    "blocked_reason"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": ["1", "2"]
    },
    "stage": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED", "SKIPPED", "ACCEPTED_RISK", "NEED_HUMAN"]
    },
    "mode": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "return_to": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "affected_work_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["solution", "test_plan", "development_evidence", "quality_result", "performance_result", "security_result"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rule_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "status", "evidence", "reason"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED", "CI_REQUIRED", "SKIPPED", "ACCEPTED_RISK"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string"}
        }
      }
    },
    "tracking_snapshot": {
      "type": "array"
    },
    "gate": {
      "type": "object"
    },
    "inputs": {
      "type": "array"
    },
    "outputs": {
      "type": "array"
    },
    "user_confirmation_required": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": "string"
    }
  }
}
